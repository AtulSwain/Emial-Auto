# ── App ────────────────────────────────────────────────────────────────
APP_URL=https://invites.otakuva.example      # public base URL of this app (no trailing slash)
DATABASE_URL=                                 # Neon Postgres (use the pooled connection string)
ADMIN_PASSWORD=                               # password for /admin
SESSION_SECRET=                               # 32+ random chars, signs the admin cookie (openssl rand -base64 32)
CRON_SECRET=                                  # 16+ random chars; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"

# ── Email ──────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend                         # resend | gmail  (outbox = local dev only: writes emails to ./.outbox)
RESEND_API_KEY=                               # only if EMAIL_PROVIDER=resend
GMAIL_USER=                                   # only if EMAIL_PROVIDER=gmail
GMAIL_APP_PASSWORD=                           # only if EMAIL_PROVIDER=gmail (16-char App Password, spaces are fine)

EMAIL_FROM="Atul from Otakuva <atul@otakuva.example>"
EMAIL_REPLY_TO=dev.swainatul@gmail.com        # replies come straight to me
ADMIN_NOTIFY_EMAIL=dev.swainatul@gmail.com    # I get a ping when someone accepts/declines

# ── Invite behaviour ───────────────────────────────────────────────────
DEFAULT_TEST_LINK=https://otakuva.vercel.app  # used when I don't enter a link per invite
FEEDBACK_URL=                                 # Google Form / Tally link for feedback (leave empty to hide the line)
ACCESS_DAYS=7                                 # length of the testing window (days)
INVITE_VALID_DAYS=14                          # how long an unaccepted invite stays valid
TIMEZONE=Asia/Kolkata                         # all dates shown to creators use this
